diff --git a/include/tcg/startup.h b/include/tcg/startup.h
index 93382de..7fa4b84 100644
--- a/include/tcg/startup.h
+++ b/include/tcg/startup.h
@@ -61,4 +61,40 @@ void tcg_prologue_init(void);
  */
 void tcg_op_histogram_dump(void);
 
+/*
+ * Execution-weighted TB profile, enabled with QEMU_TB_EXEC_PROFILE.
+ * Each translated TB gets a record (guest pc, insn count, TCG op list)
+ * and an execution counter bumped by a short host-code stub emitted at
+ * the start of the TB, so every entry path (goto_tb chain, goto_ptr
+ * lookup, main loop) is counted.  Dispatch-path counters in cpu-exec.c
+ * complete the picture.  Dumped on process exit.
+ */
+enum {
+    TCG_TBPROF_CTR_HELPER_CALLS,   /* helper_lookup_tb_ptr invocations */
+    TCG_TBPROF_CTR_HELPER_NULL,    /* ... that found no TB (to epilogue) */
+    TCG_TBPROF_CTR_JC_HIT,         /* tb_lookup: jump cache hit */
+    TCG_TBPROF_CTR_JC_MISS,        /* tb_lookup: fell back to htable, found */
+    TCG_TBPROF_CTR_MAINLOOP,       /* main-loop tb_lookup calls */
+    TCG_TBPROF_CTR_MAINLOOP_NEWTB, /* ... that translated a new TB */
+    TCG_TBPROF_CTR_NB
+};
+extern int tcg_tb_prof_on;
+extern uint64_t tcg_tb_prof_ctr[TCG_TBPROF_CTR_NB];
+
+void tcg_tb_prof_resolve(void);
+
+static inline bool tcg_tb_prof_active(void)
+{
+    if (unlikely(tcg_tb_prof_on < 0)) {
+        tcg_tb_prof_resolve();
+    }
+    return tcg_tb_prof_on > 0;
+}
+
+void tcg_tb_prof_new_rec(uint64_t pc, uint32_t n_insns);
+void tcg_tb_prof_begin_code(void);
+void tcg_tb_prof_record_op(unsigned opc);
+uint64_t *tcg_tb_prof_cur_counter(void);
+void tcg_tb_prof_dump(void);
+
 #endif
