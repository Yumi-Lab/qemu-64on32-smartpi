From b2bef83a0073653847d0be6536d9127964147e9d Mon Sep 17 00:00:00 2001
From: Yumi-Lab <nicolas@yumi-lab.com>
Date: Sun, 19 Jul 2026 08:24:54 +0200
Subject: [PATCH 05/16] linux-user: make the translation cache size
 configurable (-tb-size, QEMU_TB_SIZE)

On 32-bit hosts the user-mode translation cache is a builtin static
buffer of DEFAULT_CODE_GEN_BUFFER_SIZE (32 MiB) and nothing exposes the
existing tb-size accel property, so the cache cannot grow.  A guest
carrying a large JIT runtime overflows 32 MiB many times over during
startup: the bump allocator never reclaims, every overflow triggers a
full tb_flush, and the whole working set is retranslated in a loop.

Wire a -tb-size command line option (QEMU_TB_SIZE environment variable,
value in MiB) to the tb-size accel property, and teach the static
buffer allocator to satisfy requests larger than the builtin buffer
with a dedicated anonymous mapping, falling back to the builtin buffer
if the mapping fails.  Default behaviour is unchanged.
---
 linux-user/main.c | 15 +++++++++++++++
 tcg/region.c      | 19 +++++++++++++++++++
 2 files changed, 34 insertions(+)

diff --git a/linux-user/main.c b/linux-user/main.c
index b09af8d..aaea0fb 100644
--- a/linux-user/main.c
+++ b/linux-user/main.c
@@ -71,6 +71,7 @@ char *exec_path;
 char real_exec_path[PATH_MAX];
 
 static bool opt_one_insn_per_tb;
+static unsigned long opt_tb_size;
 static const char *argv0;
 static const char *gdbstub;
 static envlist_t *envlist;
@@ -424,6 +425,14 @@ static void handle_arg_one_insn_per_tb(const char *arg)
     opt_one_insn_per_tb = true;
 }
 
+static void handle_arg_tb_size(const char *arg)
+{
+    if (qemu_strtoul(arg, NULL, 0, &opt_tb_size) || opt_tb_size == 0) {
+        error_report("Invalid translation cache size: '%s'", arg);
+        exit(EXIT_FAILURE);
+    }
+}
+
 static void handle_arg_strace(const char *arg)
 {
     enable_strace = true;
@@ -516,6 +525,8 @@ static const struct qemu_argument arg_table[] = {
     {"one-insn-per-tb",
                    "QEMU_ONE_INSN_PER_TB",  false, handle_arg_one_insn_per_tb,
      "",           "run with one guest instruction per emulated TB"},
+    {"tb-size",    "QEMU_TB_SIZE",     true,  handle_arg_tb_size,
+     "size",       "TCG translation cache size in MiB"},
     {"strace",     "QEMU_STRACE",      false, handle_arg_strace,
      "",           "log system calls"},
     {"seed",       "QEMU_RAND_SEED",   true,  handle_arg_seed,
@@ -807,6 +818,10 @@ int main(int argc, char **argv, char **envp)
         accel_init_interfaces(ac);
         object_property_set_bool(OBJECT(accel), "one-insn-per-tb",
                                  opt_one_insn_per_tb, &error_abort);
+        if (opt_tb_size) {
+            object_property_set_int(OBJECT(accel), "tb-size",
+                                    opt_tb_size, &error_abort);
+        }
         ac->init_machine(NULL);
     }
 
diff --git a/tcg/region.c b/tcg/region.c
index 478ec05..6f199b0 100644
--- a/tcg/region.c
+++ b/tcg/region.c
@@ -509,6 +509,25 @@ static int alloc_code_gen_buffer(size_t tb_size, int splitwx, Error **errp)
         return -1;
     }
 
+    /*
+     * A translation cache larger than the builtin buffer was requested
+     * (tb-size accel property).  The builtin buffer cannot grow at run
+     * time, so serve the request with a dedicated anonymous mapping.
+     * Guests carrying a large JIT runtime overflow the small builtin
+     * buffer and spend their time in back-to-back tb_flush cycles.
+     * On mapping failure, fall through to the builtin buffer.
+     */
+    if (tb_size > sizeof(static_code_gen_buffer)) {
+        size = QEMU_ALIGN_DOWN(tb_size, qemu_real_host_page_size());
+        buf = mmap(NULL, size, PROT_READ | PROT_WRITE,
+                   MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+        if (buf != MAP_FAILED) {
+            region.start_aligned = buf;
+            region.total_size = size;
+            return PROT_READ | PROT_WRITE;
+        }
+    }
+
     /* page-align the beginning and end of the buffer */
     buf = static_code_gen_buffer;
     end = static_code_gen_buffer + sizeof(static_code_gen_buffer);
-- 
