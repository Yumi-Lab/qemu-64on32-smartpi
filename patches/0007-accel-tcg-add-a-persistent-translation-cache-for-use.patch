diff --git a/tcg/region.c b/tcg/region.c
index 6f199b0..cefc4c1 100644
--- a/tcg/region.c
+++ b/tcg/region.c
@@ -518,9 +518,28 @@ static int alloc_code_gen_buffer(size_t tb_size, int splitwx, Error **errp)
      * On mapping failure, fall through to the builtin buffer.
      */
     if (tb_size > sizeof(static_code_gen_buffer)) {
+        int flags = MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE;
+
         size = QEMU_ALIGN_DOWN(tb_size, qemu_real_host_page_size());
-        buf = mmap(NULL, size, PROT_READ | PROT_WRITE,
-                   MAP_PRIVATE | MAP_ANONYMOUS | MAP_NORESERVE, -1, 0);
+        buf = MAP_FAILED;
+
+        /*
+         * A persistent translation cache needs the buffer at the same
+         * address on every run: the generated code contains absolute
+         * host addresses.  Try a fixed spot first; if it is taken, the
+         * cache is silently unusable (the loader checks the address)
+         * but execution is unaffected.
+         */
+        if (getenv("QEMU_TB_CACHE") != NULL) {
+#ifndef MAP_FIXED_NOREPLACE
+#define MAP_FIXED_NOREPLACE 0x100000
+#endif
+            buf = mmap((void *)0x58000000, size, PROT_READ | PROT_WRITE,
+                       flags | MAP_FIXED_NOREPLACE, -1, 0);
+        }
+        if (buf == MAP_FAILED) {
+            buf = mmap(NULL, size, PROT_READ | PROT_WRITE, flags, -1, 0);
+        }
         if (buf != MAP_FAILED) {
             region.start_aligned = buf;
             region.total_size = size;
