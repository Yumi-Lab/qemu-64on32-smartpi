 include/hw/core/cpu.h          |   6 ++
 include/tcg/tcg-op-common.h    |   9 +++
 target/arm/tcg/translate-a64.c | 106 +++++++++++++++++++++++++++++++++
 tcg/tcg-op.c                   |  11 ++++
 5 files changed, 133 insertions(+)

