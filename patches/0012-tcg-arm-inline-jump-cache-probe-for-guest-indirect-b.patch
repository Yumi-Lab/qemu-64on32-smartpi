diff --git a/target/arm/tcg/translate-a64.c b/target/arm/tcg/translate-a64.c
index 422445a..c5a61e3 100644
--- a/target/arm/tcg/translate-a64.c
+++ b/target/arm/tcg/translate-a64.c
@@ -25,6 +25,9 @@
 #include "arm_ldst.h"
 #include "semihosting/semihost.h"
 #include "cpregs.h"
+#ifdef CONFIG_USER_ONLY
+#include "accel/tcg/tb-jmp-cache.h"
+#endif
 
 static TCGv_i64 cpu_X[32];
 static TCGv_i64 cpu_pc;
@@ -11882,6 +11885,105 @@ static void aarch64_tr_translate_insn(DisasContextBase *dcbase, CPUState *cpu)
     }
 }
 
+
+#ifdef CONFIG_USER_ONLY
+/*
+ * Inline jump-cache probe for guest indirect branches.  At a DISAS_JUMP
+ * exit the cpu tuple (cs_base, flags, cflags) equals the tuple this TB
+ * was translated with: any instruction that changes the hflags ends its
+ * TB through another exit kind.  The probe can therefore validate a
+ * jump-cache entry entirely against translation-time constants: pc from
+ * cpu_pc, and the cached TB's cs_base/flags/cflags against this TB's
+ * own tuple.  A cflags mismatch also catches CF_INVALID.  On any
+ * mismatch fall back to the lookup helper, which remains the only
+ * writer of the cache.  The one dynamic bit is BTYPE (in flags2, i.e.
+ * cs_base): only emit the probe when the branch leaves BTYPE at zero,
+ * and compare with BTYPE cleared from this TB's tuple.
+ */
+static void gen_lookup_and_goto_ptr_probe(DisasContext *s)
+{
+    const TranslationBlock *tb = s->base.tb;
+    CPUARMTBFlags tuple;
+    TCGLabel *slow;
+    TCGv_i32 pcl, pch, hash, tbi, t;
+    TCGv_ptr ent, tbp, tcp;
+
+    if (tb_cflags(tb) & (CF_NO_GOTO_PTR | CF_PCREL)) {
+        tcg_gen_lookup_and_goto_ptr();
+        return;
+    }
+    /* The probe hardcodes a 32-bit little-endian host entry layout. */
+    if (sizeof(void *) != 4 || HOST_BIG_ENDIAN) {
+        tcg_gen_lookup_and_goto_ptr();
+        return;
+    }
+    /* BTYPE unknown or nonzero after this branch: target flags differ. */
+    if (s->btype != 0) {
+        tcg_gen_lookup_and_goto_ptr();
+        return;
+    }
+
+    QEMU_BUILD_BUG_ON((sizeof(((CPUJumpCache *)0)->array[0]) &
+                       (sizeof(((CPUJumpCache *)0)->array[0]) - 1)) != 0);
+
+    tuple = arm_tbflags_from_tb(tb);
+    DP_TBFLAG_A64(tuple, BTYPE, 0);
+
+    slow = gen_new_label();
+    pcl = tcg_temp_new_i32();
+    pch = tcg_temp_new_i32();
+    hash = tcg_temp_new_i32();
+    tbi = tcg_temp_new_i32();
+    t = tcg_temp_new_i32();
+    ent = tcg_temp_new_ptr();
+    tbp = tcg_temp_new_ptr();
+    tcp = tcg_temp_new_ptr();
+
+    tcg_gen_extrl_i64_i32(pcl, cpu_pc);
+    tcg_gen_extrh_i64_i32(pch, cpu_pc);
+
+    /*
+     * tb_jmp_cache_hash_func: (pc ^ (pc >> TB_JMP_CACHE_BITS)) & mask.
+     * With TB_JMP_CACHE_BITS >= 12 the high pc word cannot reach the
+     * masked bits, so the low word alone computes the same hash.
+     */
+    tcg_gen_shri_i32(hash, pcl, TB_JMP_CACHE_BITS);
+    tcg_gen_xor_i32(hash, hash, pcl);
+    tcg_gen_andi_i32(hash, hash, TB_JMP_CACHE_SIZE - 1);
+    tcg_gen_shli_i32(hash, hash, ctz32(sizeof(((CPUJumpCache *)0)->array[0])));
+
+    tcg_gen_ld_ptr(ent, tcg_env,
+                   offsetof(ArchCPU, parent_obj.neg.jc_probe) -
+                   offsetof(ArchCPU, env));
+    tcg_gen_ext_i32_ptr(tbp, hash);
+    tcg_gen_add_ptr(ent, ent, tbp);
+
+    tcg_gen_ld_i32(tbi, ent, offsetof(CPUJumpCache, array[0].tb));
+    tcg_gen_brcondi_i32(TCG_COND_EQ, tbi, 0, slow);
+    tcg_gen_ld_i32(t, ent, offsetof(CPUJumpCache, array[0].pc));
+    tcg_gen_brcond_i32(TCG_COND_NE, t, pcl, slow);
+    tcg_gen_ld_i32(t, ent, offsetof(CPUJumpCache, array[0].pc) + 4);
+    tcg_gen_brcond_i32(TCG_COND_NE, t, pch, slow);
+
+    /* Validate the cached TB's tuple against this TB's constants. */
+    tcg_gen_ext_i32_ptr(tbp, tbi);
+    tcg_gen_ld_i32(t, tbp, offsetof(TranslationBlock, flags));
+    tcg_gen_brcondi_i32(TCG_COND_NE, t, tuple.flags, slow);
+    tcg_gen_ld_i32(t, tbp, offsetof(TranslationBlock, cs_base));
+    tcg_gen_brcondi_i32(TCG_COND_NE, t, (uint32_t)tuple.flags2, slow);
+    tcg_gen_ld_i32(t, tbp, offsetof(TranslationBlock, cs_base) + 4);
+    tcg_gen_brcondi_i32(TCG_COND_NE, t, (uint32_t)(tuple.flags2 >> 32), slow);
+    tcg_gen_ld_i32(t, tbp, offsetof(TranslationBlock, cflags));
+    tcg_gen_brcondi_i32(TCG_COND_NE, t, tb_cflags(tb), slow);
+
+    tcg_gen_ld_ptr(tcp, tbp, offsetof(TranslationBlock, tc.ptr));
+    tcg_gen_goto_ptr(tcp);
+
+    gen_set_label(slow);
+    tcg_gen_lookup_and_goto_ptr();
+}
+#endif /* CONFIG_USER_ONLY */
+
 static void aarch64_tr_tb_stop(DisasContextBase *dcbase, CPUState *cpu)
 {
     DisasContext *dc = container_of(dcbase, DisasContext, base);
@@ -11920,7 +12022,11 @@ static void aarch64_tr_tb_stop(DisasContextBase *dcbase, CPUState *cpu)
             gen_a64_update_pc(dc, 4);
             /* fall through */
         case DISAS_JUMP:
+#ifdef CONFIG_USER_ONLY
+            gen_lookup_and_goto_ptr_probe(dc);
+#else
             tcg_gen_lookup_and_goto_ptr();
+#endif
             break;
         case DISAS_NORETURN:
         case DISAS_SWI:
diff --git a/tcg/tcg-op.c b/tcg/tcg-op.c
index 4a7e705..0e73b00 100644
--- a/tcg/tcg-op.c
+++ b/tcg/tcg-op.c
@@ -3353,3 +3353,14 @@ void tcg_gen_lookup_and_goto_ptr(void)
     tcg_gen_op1i(INDEX_op_goto_ptr, tcgv_ptr_arg(ptr));
     tcg_temp_free_ptr(ptr);
 }
+
+/*
+ * Jump to a host code address already known to be the entry point of a
+ * valid TB for the current cpu state, e.g. from an inline jump-cache
+ * probe.  The caller is responsible for the validity argument.
+ */
+void tcg_gen_goto_ptr(TCGv_ptr ptr)
+{
+    plugin_gen_disable_mem_helpers();
+    tcg_gen_op1i(INDEX_op_goto_ptr, tcgv_ptr_arg(ptr));
+}
